rules_version = '2';

// Datenmodell: teams/{teamId}/{meta,members,invites,players,events,opponents}
// Siehe README/FIREBASE_SETUP.md fuer den Hintergrund. Kernidee:
// - "members/{uid}" verknuepft eine angemeldete Firebase-Auth-Identitaet mit einer
//   Rolle ("trainer" oder "player") und - fuer Spieler - der eigenen playerId.
// - Ein Trainer darf alles lesen/schreiben. Ein Spieler darf nur sein eigenes
//   Spielerprofil, seinen eigenen Foerderplan und seine eigenen Bewertungen lesen -
//   nie die Daten anderer Spieler.
service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{teamId} {

      function isSignedIn() {
        return request.auth != null;
      }

      function memberExists() {
        return exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      }

      function memberDoc() {
        return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
      }

      // Spieler-Zugaenge koennen ein Ablaufdatum ("expiresAt", Timestamp) haben - fehlt
      // das Feld oder ist es null, ist der Zugang unbefristet. Trainer-Dokumente (manuell
      // in der Firebase-Konsole angelegt, siehe FIREBASE_SETUP.md) haben das Feld ueberhaupt
      // nicht gesetzt. Direkter Feldzugriff (".data.expiresAt") wuerde in diesem Fall die
      // gesamte Regelauswertung mit einem Fehler abbrechen (Firestore behandelt den Zugriff
      // auf ein nicht vorhandenes Map-Feld nicht als "null", sondern als Auswertungsfehler -
      // das war vermutlich die Ursache des fruehren, nie ganz geklaerten isTrainer()-Bugs).
      // ".get(feld, default)" ist der dafuer vorgesehene, sichere Zugriffsweg.
      function isExpired() {
        return memberDoc().data.get('expiresAt', null) != null && memberDoc().data.get('expiresAt', null) < request.time;
      }

      function isTeamMember() {
        return isSignedIn() && memberExists() && !isExpired();
      }

      function isTrainer() {
        return isTeamMember() && memberDoc().data.role == "trainer";
      }

      // Scout und Medizin sind seit SCRUM-170 zwei getrennte Rollen:
      // - "physio" (UI: "Medizin-Zugang"): Spielerliste, Status, Abwesenheiten/Verletzungen und Messwerte
      //   aller Spieler lesen - genau das, was bis SCRUM-170 die Rolle "medical" durfte. Keine Noten.
      // - "scout" (UI: "Scout-Zugang"): nur die vom Trainer-Client geschriebene, bereinigte Scout-Sicht
      //   (scoutProfiles: Kompetenzprofil, Notenverlauf, Statistik). KEINE Gesundheitsdaten: weder
      //   Spielerdokumente (Status, Verletzt bis ...), Abwesenheiten, Messwerte, Bewertungsdokumente (deren
      //   Rueckmeldung kann einen Abwesenheitsgrund enthalten), interne Notizen noch Event-Notizen.
      // "medical" ist die alte Kennung des bisherigen "Scout-Zugangs" (SCRUM-91). Entscheidung des PO
      // (20.10.2026): bestehende Konten werden Scout-Konten. Deshalb gilt "medical" ab sofort als Scout -
      // die Konten verlieren den Zugriff auf Gesundheitsdaten mit dem Deploy dieser Regeln, ohne dass ein
      // Dokument umgeschrieben werden muss. Neue "medical"-Konten koennen nicht mehr angelegt werden; der
      // Medizin-Zugang nutzt die neue, vorher nie vergebene Kennung "physio".
      function isScout() {
        return isTeamMember() && memberDoc().data.role in ["scout", "medical"];
      }

      function isPhysio() {
        return isTeamMember() && memberDoc().data.role == "physio";
      }

      // Alle Rollen ausser Scout, die Termine (Titel, Datum, Ort, Event-Notizen) lesen duerfen.
      function readsEvents() {
        return isTeamMember() && memberDoc().data.role in ["trainer", "physio", "player", "parent"];
      }

      function isPlayerFor(playerId) {
        return isTeamMember()
          && memberDoc().data.role in ["player", "parent"]
          && memberDoc().data.playerId == playerId;
      }

      match /members/{uid} {
        // Trainer duerfen die ganze Liste sehen (Zugaenge verwalten); diese Regel
        // haengt nicht von resource-Daten ab und ist daher fuer Listenabfragen sicher.
        allow read: if isTrainer() || (isSignedIn() && request.auth.uid == uid);
        // Zwei erlaubte Wege, ein members/{uid}-Dokument anzulegen:
        // 1. Ein bereits bestehender Trainer legt (in der App, ueber eine zweite,
        //    temporaere Firebase-App-Instanz fuer den neuen Auth-User - siehe
        //    createTrainerAccount() in app.js) ein weiteres Trainer-Konto an. Die neue
        //    UID gehoert dabei nicht dem aufrufenden Trainer, deshalb kein
        //    "request.auth.uid == uid" in diesem Zweig. Das allererste Trainer-Konto
        //    braucht weiterhin einen manuellen Bootstrap-Schritt in der Firebase-Konsole
        //    (Authentication: Nutzer anlegen: Firestore: passendes members/{uid}-Dokument
        //    anlegen), siehe FIREBASE_SETUP.md - danach reicht dieser Weg fuer alle
        //    weiteren Trainer/Co-Trainer.
        // 2. Ein frisch (anonym) angemeldeter Spieler traegt sich selbst mit einem
        //    gueltigen Einladungscode ein. Der Code ist ein Einmal-Code: Der Eintrag und das
        //    Loeschen des Codes muessen im selben Batch stehen (siehe unten, SCRUM-77).
        // Die Diagnose (auch "if true" scheiterte beim allerersten Versuch nach einem
        // Deploy, klappte aber nach einem Neuladen) zeigt: es lag nie an der Regel-Logik,
        // sondern an der kurzen Verzoegerung, bis ein frisch deployter Regelsatz global
        // greift.
        allow create: if
          (isTrainer() && request.resource.data.role in ["trainer", "scout", "physio"])
          || (
            isSignedIn() && request.auth.uid == uid
            && request.resource.data.role in ["player", "parent"]
            && request.resource.data.playerId is string
            && request.resource.data.claimedInviteCode is string
            // Nur die vorgesehenen Felder, Zeitstempel vom Server (SCRUM-63).
            && request.resource.data.keys().hasOnly(['role', 'playerId', 'claimedInviteCode', 'expiresAt', 'createdAt'])
            && request.resource.data.createdAt == request.time
            // Einmalverbrauch (SCRUM-77): Die Mitgliedschaft darf nur angelegt werden, wenn
            // derselbe Schreibvorgang (Batch) den Einladungscode loescht. Beide Clients
            // (outputs/*/app.js, angular firebase.service.ts) schreiben so. Ein zweiter
            // Versuch mit demselben Code scheitert, weil der Code dann nicht mehr existiert.
            && !existsAfter(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.claimedInviteCode))
            && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.claimedInviteCode)).data.playerId == request.resource.data.playerId
            && get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.claimedInviteCode)).data.role == request.resource.data.role
            && request.resource.data.expiresAt == get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.claimedInviteCode)).data.expiresAt
            && (
              get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.claimedInviteCode)).data.expiresAt == null
              || get(/databases/$(database)/documents/teams/$(teamId)/invites/$(request.resource.data.claimedInviteCode)).data.expiresAt > request.time
            )
          );
        // Kein Update: eine bestehende Mitgliedschaft wird nicht bearbeitet, sondern
        // vom Trainer geloescht (Zugang sperren) und bei Bedarf neu eingeladen.
        allow update: if false;
        allow delete: if isTrainer();
      }

      match /invites/{code} {
        // Ein frisch (anonym) angemeldeter Spieler ist zu diesem Zeitpunkt noch kein
        // Teammitglied - er muss den EINEN Code, den er kennt, trotzdem lesen duerfen,
        // um sich ueberhaupt registrieren zu koennen. "get" (gezielter Abruf eines
        // bekannten Codes) wird deshalb fuer jeden Angemeldeten erlaubt; "list" (alle
        // Codes auflisten) bleibt bewusst auf Trainer beschraenkt.
        allow get: if isTrainer() || isSignedIn();
        allow list: if isTrainer();
        // War zwischenzeitlich eine abgeflachte Sonderpruefung (isTrainer() schlug hier
        // unerklaert fehl) - die Ursache ist inzwischen gefunden und behoben: isExpired()
        // griff direkt auf ein bei Trainer-Konten fehlendes "expiresAt"-Feld zu, was die
        // gesamte Regelauswertung mit einem Fehler abbrechen liess statt "false" zu liefern.
        // Jetzt wieder die normale, konsistente Pruefung.
        allow create: if isTrainer();
        // Kein Update noetig - beim Einloesen wird der Code nicht veraendert, sondern
        // zusammen mit dem members-Eintrag geloescht (Einmalverbrauch, SCRUM-77).
        allow update: if false;
        allow delete: if isTrainer() || (
          isSignedIn()
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role in ["player", "parent"]
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.playerId == resource.data.playerId
          && getAfter(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.claimedInviteCode == code
        );
      }

      // "players/{playerId}" wird von Spielern immer per direktem Dokument-Get
      // abgerufen (nie als Listenabfrage der ganzen Collection), deshalb reicht hier
      // der Pfad-Vergleich. "ratings" und "developmentPlans" werden von Spielern dagegen
      // per collectionGroup-Abfrage mit einem "where(playerId == ...)"-Filter gelesen -
      // Firestore kann eine Listenabfrage nur zulassen, wenn die Regel selbst auf ein
      // Datenfeld (nicht auf das Pfadsegment) prueft, das exakt zum Abfragefilter passt.
      // Deshalb tragen diese beiden Dokumenttypen zusaetzlich ein eigenes "playerId"-Feld.
      match /players/{playerId} {
        allow read: if isTrainer() || isPhysio() || isPlayerFor(playerId);
        allow write: if isTrainer();

        match /developmentPlans/{planId} {
          // ".get('playerId', null)" statt direktem Feldzugriff - gleiche Absicherung wie
          // bei isExpired(): ein Trainer-Dokument hat kein "playerId"-Feld, direkter
          // Zugriff wuerde die Regelauswertung in diesem (eigentlich schon durch
          // isTrainer() abgedeckten) Fall unnoetig riskant machen.
          allow read: if isTrainer() || (isTeamMember() && memberDoc().data.role in ["player", "parent"] && resource.data.playerId == memberDoc().data.get('playerId', null));
          allow create, delete: if isTrainer();
          allow update: if isTrainer() || (
            isTeamMember()
            && memberDoc().data.role == "player"
            && resource.data.playerId == memberDoc().data.get('playerId', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["selfReflection", "selfReflectionAt"])
            // Typ und Laenge wie im Client (Textfeld max. 400 Zeichen, Zeitpunkt als ISO-Text) - SCRUM-63.
            && request.resource.data.selfReflection is string && request.resource.data.selfReflection.size() <= 400
            && request.resource.data.selfReflectionAt is string && request.resource.data.selfReflectionAt.size() <= 40
          );
        }

        match /absences/{absenceId} {
          allow read: if isTrainer() || isPhysio() || (isTeamMember() && memberDoc().data.role in ["player", "parent"] && resource.data.playerId == memberDoc().data.get('playerId', null));
          allow write: if isTrainer();
        }

        match /measurements/{measurementId} {
          allow read: if isTrainer() || isPhysio() || (isTeamMember() && memberDoc().data.role in ["player", "parent"] && resource.data.playerId == memberDoc().data.get('playerId', null));
          allow write: if isTrainer();
        }
      }

      match /events/{eventId} {
        // Scouts lesen keine Event-Dokumente (Event-Notizen sind Freitext des Trainers); was sie von einem
        // Termin brauchen (Datum, Art, Titel, Gegner, Ergebnis), steht in scoutProfiles.
        allow read: if readsEvents();
        allow write: if isTrainer();

        match /ratings/{playerId} {
          // ".get('playerId', null)" statt direktem Feldzugriff - gleiche Absicherung wie
          // bei isExpired(): ein Trainer-Dokument hat kein "playerId"-Feld, direkter
          // Zugriff wuerde die Regelauswertung in diesem (eigentlich schon durch
          // isTrainer() abgedeckten) Fall unnoetig riskant machen.
          allow read: if isTrainer() || (isTeamMember() && memberDoc().data.role in ["player", "parent"] && resource.data.playerId == memberDoc().data.get('playerId', null));
          allow write: if isTrainer();
        }

        // Interne Trainer-Notizen zu einer Bewertung. Bewusst ein eigener Pfad: das
        // Bewertungsdokument darf der Spieler/das Elternteil komplett lesen, dieser Pfad
        // nie (kein Eintrag fuer player/parent/physio/scout).
        match /privateNotes/{playerId} {
          allow read, write: if isTrainer();
        }

        // Zu-/Absagen (SCRUM-175): Spieler bzw. Eltern antworten nur fuer den eigenen Spieler (Dokument-ID =
        // eigene playerId) und nur fuer ein bestehendes Event. Erlaubt sind genau diese Felder: Zusage/Absage,
        // ein kurzer, freiwilliger Grund, wer geantwortet hat (Spieler oder Eltern) und der Server-Zeitstempel.
        // Der Grund kann ein Gesundheitsdatum sein ("krank") - lesen duerfen ihn deshalb nur der Trainer und
        // der eigene Spieler bzw. die eigenen Eltern, nicht Medizin oder Scouts. Spieler lesen per gezieltem Get
        // (nie als Liste), deshalb reicht der Pfadvergleich. Die Anwesenheit ("Fehlt") setzt weiterhin nur der
        // Trainer-Client in der Bewertung; Loeschen nur der Trainer (Spieler/Event loeschen).
        match /responses/{playerId} {
          allow read: if isTrainer() || isPlayerFor(playerId);
          allow create, update: if isPlayerFor(playerId)
            && exists(/databases/$(database)/documents/teams/$(teamId)/events/$(eventId))
            && request.resource.data.keys().hasOnly(['playerId', 'status', 'reason', 'by', 'updatedAt'])
            && request.resource.data.playerId == playerId
            && request.resource.data.status in ["yes", "no"]
            && request.resource.data.reason is string
            && request.resource.data.reason.size() <= 200
            && (request.resource.data.status == "no" || request.resource.data.reason == "")
            && request.resource.data.by == memberDoc().data.role
            && request.resource.data.updatedAt == request.time;
          allow delete: if isTrainer();
        }
      }

      // Scout-Sicht (SCRUM-170): je Spieler ein Dokument, das ausschliesslich der Trainer-Client schreibt
      // (buildScoutProfiles in outputs/*/app.js, scout-profile.ts in angular/). Enthaelt Name, Nummer,
      // Positionen, Geburtsdatum und je Termin nur Datum/Art/Titel/Gegner/Ergebnis, Anwesenheit ohne Grund,
      // Teilnoten, Minuten, Tore und Vorlagen - keine Rueckmeldungen, Notizen, Status oder Gesundheitsdaten.
      // hasOnly sichert ab, dass kein weiteres Feld (z.B. "status" oder "injuryUntil") hineinrutscht.
      match /scoutProfiles/{playerId} {
        allow read: if isTrainer() || isScout();
        allow create, update: if isTrainer()
          && request.resource.data.keys().hasOnly(['playerId', 'name', 'number', 'positions', 'birthdate', 'entries', 'version'])
          && request.resource.data.playerId == playerId
          && request.resource.data.entries is list;
        allow delete: if isTrainer();
      }

      // Zusammenfassung je Spieler (SCRUM-201, nur Angular): je Event Anwesenheit, Teilnoten, Minuten, Tore und
      // Vorlagen - dieselben Werte wie in den Bewertungen, ohne Rueckmeldung und interne Notizen. Der Trainer-Client
      // schreibt sie im selben Schreibvorgang wie jede Bewertung mit. Nur Trainer lesen und schreiben; Spieler, Eltern,
      // Medizin und Scouts haben keinen Zugriff (Spieler lesen ihre eigenen Bewertungen weiter direkt).
      // hasOnly/Typen sichern das Format ab, damit kein weiteres Feld (z.B. Notizen) hineinrutscht.
      match /playerStats/{playerId} {
        allow read: if isTrainer();
        allow create, update: if isTrainer()
          && request.resource.data.keys().hasOnly(['playerId', 'version', 'events'])
          && request.resource.data.playerId == playerId
          && request.resource.data.version is int
          && request.resource.data.events is map;
        allow delete: if isTrainer();
      }

      // Kennzeichen "Zusammenfassungen sind eingerichtet" (Version, Zeitpunkt der Neuberechnung) - nur Trainer.
      match /meta/playerStats {
        allow read, write: if isTrainer();
      }

      match /opponents/{opponentId} {
        allow read, write: if isTrainer();
      }

      // Startelf/Taktikboard - wie das gesamte Dashboard nur fuer Trainer sichtbar,
      // deshalb ein einzelnes Dokument statt einer Unter-Collection.
      match /meta/lineup {
        allow read, write: if isTrainer();
      }

      // Teameinstellungen (Standardort/Heimplatz fuer neue Events), SCRUM-97 - nur Trainer.
      match /meta/settings {
        allow read, write: if isTrainer();
      }

      // Planung (Trainingsserien, SCRUM-145) - nur Trainer.
      match /meta/planning {
        allow read, write: if isTrainer();
      }

      // Pausen (Ferien, Winterpause; SCRUM-148/150) - bewusst ein eigenes Dokument neben meta/planning: jedes
      // Teammitglied darf es lesen (Hinweis "Winterpause bis 10.01." fuer Spieler), enthaelt aber nur Name und
      // Zeitraum. Die Serien in meta/planning bleiben Trainern vorbehalten. Schreiben darf nur der Trainer.
      match /meta/breaks {
        allow read: if isTeamMember();
        allow write: if isTrainer();
      }

      match /meta/operations {
        allow read, write: if isTrainer();
      }

      // Benachrichtigungs-Einstellungen je Konto (SCRUM-100): E-Mail-Erinnerung an offene Bewertungen (Opt-in).
      // Nur der Trainer selbst darf sein eigenes Dokument lesen und schreiben (Dokument-ID = eigene uid). Das Dokument
      // enthaelt ausschliesslich das Feld "emailReminders" (bool); die E-Mail-Adresse wird nie gespeichert. Der spaetere
      // Erinnerungsdienst (Admin-SDK) umgeht die Regeln. Pfad bewusst teams/{teamId}/notifications/{uid}: ein Pfad
      // teams/.../meta/notifications/{uid} waere kein gueltiger Dokumentpfad (gerade Segmentanzahl).
      match /notifications/{uid} {
        allow read: if isTrainer() && request.auth.uid == uid;
        allow create, update: if isTrainer() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['emailReminders'])
          && request.resource.data.emailReminders is bool;
        allow delete: if isTrainer() && request.auth.uid == uid;
      }

      // Altes Einzeldokument aus dem Single-Blob-Modell - nur fuer die einmalige
      // Migration in die neue Struktur, danach kann es geloescht werden.
      match /appState/current {
        allow read, write: if isTrainer();
      }
    }
  }
}
